.collection-page { min-height: 100vh; background: var(--bg); overflow: hidden; }
.collection-hero { position: relative; min-height: 293rpx; padding: 24rpx 39rpx 27rpx; overflow: hidden; background: #ffebe4; border-radius: 0 0 43rpx 43rpx; }
.collection-hero::before { content: ''; position: absolute; top: 127rpx; right: 58rpx; width: 211rpx; height: 211rpx; border: 1rpx solid rgba(255,255,255,.63); border-radius: 50%; }
.collection-hero::after { content: ''; position: absolute; right: 0; bottom: 0; left: 0; height: 60rpx; background: linear-gradient(180deg, rgba(255,235,228,0), #ffebe4); }
.collection-hero-top { position: relative; z-index: 2; display: flex; align-items: center; }
.collection-mark { display: flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; color: #fffdf9; background: #e79089; border-radius: 50% 50% 50% 8rpx; font-size: 26rpx; }
.collection-edition { margin-left: 12rpx; color: #b4867e; font-family: var(--mono); font-size: 14rpx; letter-spacing: 1.4rpx; }
.collection-clear { display: flex; align-items: center; height: 43rpx; margin-left: auto; padding: 0 13rpx; color: #805c67; background: rgba(255,254,250,.72); border: 1rpx solid rgba(238,157,138,.19); border-radius: 999rpx; font-size: 16rpx; }
.collection-clear text { margin-left: 7rpx; font-size: 18rpx; }
.collection-kicker { position: relative; z-index: 1; display: block; margin-top: 20rpx; color: #b58d84; font-family: var(--mono); font-size: 15rpx; letter-spacing: 1.7rpx; }
.collection-title-row { position: relative; z-index: 1; display: flex; align-items: flex-end; margin-top: 3rpx; }
.collection-title { color: #5a4541; font-family: var(--display); font-size: 41rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.2; }
.collection-num { margin: 0 0 4rpx 16rpx; color: #df8e8b; font-family: var(--mono); font-size: 23rpx; }
.collection-desc { position: relative; z-index: 1; display: block; margin-top: 6rpx; color: #7e747d; font-size: 20rpx; }
.collection-footline { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 14rpx; color: #a0969e; font-size: 16rpx; }
.collection-local-dot { width: 9rpx; height: 9rpx; margin-right: 8rpx; background: #ee9d8a; border-radius: 50%; box-shadow: 0 0 0 5rpx rgba(238,157,138,.1); }
.collection-footline view { width: 1rpx; height: 18rpx; margin: 0 12rpx; background: #d8c7ca; }
.collection-hero-orb { position: absolute; right: -93rpx; bottom: -154rpx; width: 260rpx; height: 260rpx; border: 1rpx solid rgba(238,157,138,.15); border-radius: 50%; box-shadow: 0 0 0 25rpx rgba(255,255,255,.15), 0 0 0 50rpx rgba(255,255,255,.1); }
.collection-list { padding: 0 31rpx 20rpx; }
.list-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 27rpx 5rpx 16rpx; }
.list-kicker { display: block; color: #a097a0; font-family: var(--mono); font-size: 14rpx; letter-spacing: 1.5rpx; }
.list-title { display: block; margin-top: 3rpx; color: var(--ink); font-family: var(--display); font-size: 27rpx; font-weight: 600; }
.list-count { color: var(--primary-deep); font-family: var(--mono); font-size: 19rpx; }
.list-count text { color: #a69ca4; font-size: 12rpx; letter-spacing: 1rpx; }
.collection-item { position: relative; display: flex; align-items: center; min-height: 191rpx; margin-bottom: 16rpx; padding: 13rpx 53rpx 13rpx 13rpx; overflow: hidden; background: var(--card); border: 1rpx solid #f3e4dc; border-radius: 23rpx; box-shadow: var(--shadow); }
.item-art { flex: 0 0 174rpx; width: 174rpx; height: 164rpx; overflow: hidden; border-radius: 16rpx; }
.item-icon { display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 43rpx; }
.item-spine { display: flex; align-items: flex-start; justify-content: center; flex: 0 0 27rpx; width: 27rpx; height: 117rpx; margin: 0 4rpx 0 0; padding-top: 7rpx; color: #d9928d; border-right: 1rpx solid #e8dcde; font-family: var(--mono); font-size: 14rpx; }
.item-body { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 4rpx 0; }
.item-overline { display: flex; align-items: center; min-height: 25rpx; }
.item-category { overflow: hidden; color: #b58e86; font-family: var(--mono); font-size: 14rpx; letter-spacing: .7rpx; white-space: nowrap; text-overflow: ellipsis; }
.item-status { margin-left: 8rpx; padding: 1rpx 7rpx; color: #b47b6f; background: #fff0e9; border-radius: 7rpx; font-size: 13rpx; white-space: nowrap; }
.item-name { display: block; margin-top: 3rpx; color: var(--ink); font-family: var(--display); font-size: 24rpx; font-weight: 600; line-height: 1.35; }
.item-desc { display: block; margin-top: 3rpx; color: var(--ink-3); font-size: 17rpx; line-height: 1.45; }
.item-meta { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 9rpx; }
.item-time { overflow: hidden; color: #a69ca4; font-size: 14rpx; white-space: nowrap; text-overflow: ellipsis; }
.item-open { margin-left: 8rpx; color: #936c76; font-size: 16rpx; white-space: nowrap; }
.item-remove { position: absolute; top: 9rpx; right: 9rpx; display: flex; align-items: center; color: #a49aa0; font-size: 14rpx; }
.remove-cross { display: flex; align-items: center; justify-content: center; width: 27rpx; height: 27rpx; margin-left: 3rpx; color: #bd8280; background: #ffe9e1; border-radius: 50%; font-size: 20rpx; line-height: 1; }
.item-unavailable { opacity: .68; }
.collection-item-hover { background: #fdf9f6; box-shadow: var(--shadow-hover); transform: translateY(-2rpx); }
.collection-end { display: flex; align-items: center; justify-content: center; margin: 29rpx 2rpx 13rpx; color: #a69ca4; font-size: 17rpx; }
.collection-end view { flex: 1; height: 1rpx; background: #f0e0db; }
.collection-end text { padding: 0 14rpx; }
.collection-empty { display: flex; flex-direction: column; align-items: center; margin: 34rpx 31rpx 0; padding: 50rpx 30rpx 48rpx; background: var(--card); border: 1rpx solid #f3e4dc; border-radius: 27rpx; box-shadow: var(--shadow); text-align: center; }
.empty-bookmark { display: flex; align-items: center; justify-content: center; width: 89rpx; height: 89rpx; color: #e78c8a; background: #ffe9e1; border: 1rpx solid #ead7da; border-radius: 31rpx 31rpx 31rpx 8rpx; font-family: var(--display); font-size: 41rpx; }
.empty-kicker { margin-top: 20rpx; color: #a297a0; font-family: var(--mono); font-size: 15rpx; letter-spacing: 1.7rpx; }
.collection-empty .state-title { margin-top: 8rpx; font-size: 29rpx; }
.collection-empty .state-desc { max-width: 480rpx; margin-top: 8rpx; font-size: 19rpx; line-height: 1.75; }
.empty-action { display: flex; align-items: center; height: 57rpx; margin-top: 21rpx; padding: 0 19rpx; color: var(--primary-deep); background: #fff0e9; border: 1rpx solid #ead8db; border-radius: 999rpx; font-size: 18rpx; }
.empty-action text { margin-left: 8rpx; }
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 27rpx); }
