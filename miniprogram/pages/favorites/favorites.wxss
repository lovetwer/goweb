/* pages/favorites/favorites.wxss */

.fav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx 22rpx;
}

.fav-head-text {
  display: flex;
  flex-direction: column;
}

.fav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.fav-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.fav-clear {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  color: #e5484d;
}

.fav-list {
  padding: 0 24rpx;
}

.fav-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx 76rpx 22rpx 22rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(28, 29, 33, 0.04);
}

.fav-item-hover {
  background: #fafbfc;
}

.fav-cover {
  width: 140rpx;
  height: 105rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}

.fav-cover-img {
  width: 140rpx;
  height: 105rpx;
  display: block;
}

.fav-cover-fallback {
  width: 140rpx;
  height: 105rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-cover-initial {
  font-size: 44rpx;
  font-weight: 600;
  color: rgba(28, 29, 33, 0.28);
}

.fav-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.fav-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fav-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.fav-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
}

.fav-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.fav-url {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.fav-remove {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f3f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-remove-x {
  font-size: 34rpx;
  color: #8b9099;
  line-height: 1;
  margin-top: -4rpx;
}

.fav-count {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c2c7d0;
}

/* 空状态里的星星（CSS 绘制） */
.state-icon.star-state {
  background: #eef0f4;
  position: relative;
}

.state-icon.star-state::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  margin: -26rpx 0 0 -26rpx;
  background: #c3c8d1;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

.btn-hover {
  opacity: 0.85;
}
