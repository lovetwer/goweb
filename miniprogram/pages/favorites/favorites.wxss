/* pages/favorites/favorites.wxss —— 与首页同一套薄荷清新版式（清新浅底，白卡片，清新绿仅「清空」等少数处） */

/* ================= 头部 ================= */
.fav-header {
  padding: 24rpx 32rpx 28rpx;
  background: var(--bg);
  border-bottom: 2rpx solid var(--line);
}

.fav-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fav-kicker {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--ink-4);
}

.fav-clear {
  padding: 8rpx 22rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 999rpx;
  background: var(--card);
}

/* 破坏性操作（清空）：清新绿文字提示 */
.fav-clear-text {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--primary);
}

.fav-title-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.fav-title {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--black);
}

.fav-num {
  margin-left: 20rpx;
  font-family: var(--mono);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--ink-4);
}

.fav-head-rule {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.fav-head-rule-mark {
  width: 88rpx;
  height: 6rpx;
  background: var(--primary);
}

.fav-head-rule-grey {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

/* 「仅保存在本机，不上传服务器」：隐私承诺提到 --ink-3 */
.fav-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

/* ================= 列表 ================= */
.fav-list {
  padding: 20rpx 24rpx 0;
  background: var(--bg);
}

.fav-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx 84rpx 22rpx 24rpx;
  margin-bottom: 18rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.fav-item-hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-2rpx);
}

/* 工具图标：分类浅底 + 分类色字符 */
.fav-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.fav-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.fav-name-row {
  display: flex;
  align-items: center;
}

.fav-name {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--black);
  letter-spacing: 0.5rpx;
}

/* 已下架标记 */
.fav-dead-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: var(--fill);
  border: 2rpx solid var(--line-2);
  border-radius: 999rpx;
  font-size: 19rpx;
  color: var(--ink-3);
}

.fav-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-family: var(--mono);
  font-size: 26rpx;
  color: var(--ink-4);
}

.fav-item-hover .fav-arrow {
  color: var(--black);
}

.fav-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.62;
}

.fav-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.fav-tag {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 3rpx 12rpx 3rpx 10rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--fill);
}

.fav-tag-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--ink-4);
  margin-right: 8rpx;
}

.fav-tag-text {
  font-size: 19rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}

/* 收藏时间：用户判断「这条是什么时候收的」要看它，提到 --ink-3 */
.fav-time {
  font-family: var(--mono);
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 删除按钮：CSS 画的叉。
   破坏性操作的图标必须看得见 —— 用 --ink-3，
   hover 时再变清新绿，形成「平时清楚 / 悬停警示」两级。 */
.fav-remove {
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 48rpx;
  height: 48rpx;
}

.rm-x,
.rm-y {
  position: absolute;
  left: 10rpx;
  top: 22rpx;
  width: 28rpx;
  height: 3rpx;
  background: var(--ink-3);
  border-radius: 2rpx;
}

.rm-x {
  transform: rotate(45deg);
}

.rm-y {
  transform: rotate(-45deg);
}

.fav-item-hover .rm-x,
.fav-item-hover .rm-y {
  background: var(--primary);
}

/* 已下架条目整体压淡 */
.fav-item-dead .fav-name,
.fav-item-dead .fav-desc {
  color: var(--ink-3);
}

.fav-item-dead .fav-icon {
  opacity: 0.5;
}

/* ================= 统计 ================= */
.fav-count {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 10rpx;
}

.fav-count-line {
  width: 90rpx;
  height: 2rpx;
  background: var(--line);
}

.fav-count-text {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
  margin: 0 20rpx;
}

/* ================= 空状态图标：CSS 书签 ================= */
.state-icon.star-state {
  border-color: var(--line-2);
  position: relative;
  background: var(--card);
}

.state-icon.star-state::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 52rpx;
  margin: -28rpx 0 0 -20rpx;
  background: var(--line-2);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
}

/* 工具预览：使用工具对应插画，非字符占位图标 */
.fav-image {
  display: block;
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #eaf3e9;
}
