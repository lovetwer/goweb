.mine-page { min-height: 100vh; background: var(--bg); }
.mine-content { padding: 22rpx 38rpx 0; }
.section-kicker { display: block; color: #a097a0; font-family: var(--mono); font-size: 16rpx; letter-spacing: 2rpx; }
.mine-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.mine-title { display: block; margin-top: 3rpx; color: var(--ink); font-family: var(--display); font-size: 41rpx; font-weight: 600; line-height: 1.2; }
.mine-heading-mark { display: flex; align-items: center; justify-content: center; width: 55rpx; height: 55rpx; color: #c58077; background: #f8e5dc; border-radius: 19rpx 19rpx 19rpx 6rpx; font-size: 26rpx; }
.mine-note { display: flex; align-items: center; padding: 17rpx 19rpx; background: #fff3ec; border: 1rpx solid #f1e0d8; border-radius: 22rpx; }
.mine-note-mark { display: flex; align-items: center; justify-content: center; width: 53rpx; height: 53rpx; margin-right: 15rpx; color: var(--primary-deep); background: #f8dfd7; border-radius: 18rpx 18rpx 18rpx 6rpx; font-size: 26rpx; }
.mine-note-copy { display: flex; flex-direction: column; min-width: 0; }
.mine-note-title { color: var(--ink-2); font-family: var(--display); font-size: 22rpx; font-weight: 600; }
.mine-note-desc { margin-top: 2rpx; color: var(--ink-3); font-size: 17rpx; }
.mine-stats { display: flex; margin-top: 18rpx; }
.mine-stat { flex: 1; min-width: 0; height: 172rpx; padding: 16rpx 18rpx 14rpx; border: 1rpx solid rgba(224,214,214,.75); border-radius: 22rpx; box-shadow: 0 7rpx 18rpx rgba(151,93,75,.04); }
.mine-stat + .mine-stat { margin-left: 15rpx; }
.mine-stat-fav { background: #fff0e9; }
.mine-stat-history { background: #f3eafa; }
.mine-stat-top { display: flex; align-items: center; justify-content: space-between; }
.mine-stat-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; color: #a96665; background: rgba(255,255,255,.62); border-radius: 14rpx; font-size: 24rpx; }
.mine-stat-history .mine-stat-icon { color: #8e7899; }
.mine-stat-arrow { color: #ae8e92; font-size: 20rpx; }
.mine-stat-count { margin-top: 10rpx; color: var(--ink); font-family: var(--display); font-size: 30rpx; font-weight: 600; line-height: 1.15; }
.mine-stat-count text { color: var(--ink-3); font-family: inherit; font-size: 17rpx; font-weight: 400; }
.mine-stat-label { display: block; margin-top: 3rpx; color: var(--ink-3); font-size: 18rpx; }
.mine-stat-hover { opacity: .8; transform: translateY(-2rpx); }
.mine-vip { position: relative; display: flex; align-items: center; min-height: 142rpx; margin-top: 18rpx; padding: 19rpx 22rpx; overflow: hidden; background: #fff2d5; border: 1rpx solid #eadfbe; border-radius: 23rpx; }
.mine-vip-art { position: absolute; top: -9rpx; right: 0; width: 175rpx; height: 149rpx; opacity: .75; }
.mine-vip-copy { position: relative; z-index: 2; display: flex; flex-direction: column; max-width: 420rpx; }
.mine-vip-kicker { color: #b29163; font-family: var(--mono); font-size: 12rpx; letter-spacing: 1rpx; }
.mine-vip-title { margin-top: 3rpx; color: #604b43; font-family: var(--display); font-size: 25rpx; font-weight: 600; }
.mine-vip-desc { margin-top: 3rpx; color: #897e71; font-size: 17rpx; }
.mine-vip-desc text { color: #9c735e; }
.mine-vip-stamp { position: absolute; z-index: 2; top: 13rpx; right: 15rpx; color: #d1a65f; font-size: 22rpx; }
.mine-vip-hover { opacity: .82; }
.mine-section { margin-top: 34rpx; }
.mine-section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 0 3rpx 14rpx; }
.mine-section-title { color: var(--ink); font-family: var(--display); font-size: 27rpx; font-weight: 600; }
.mine-section-kicker { color: #b0a4a8; font-family: var(--mono); font-size: 12rpx; letter-spacing: 1rpx; }
.mine-menu { overflow: hidden; background: var(--card); border: 1rpx solid #f1e4de; border-radius: 22rpx; box-shadow: 0 7rpx 20rpx rgba(151,93,75,.045); }
.mine-row { display: flex; align-items: center; min-height: 106rpx; padding: 15rpx 18rpx; }
.mine-row + .mine-row { border-top: 1rpx solid #f3e9e4; }
.mine-row-hover { background: #fff8f4; }
.mine-row-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 14rpx; border-radius: 16rpx 16rpx 16rpx 5rpx; font-size: 22rpx; }
.mine-icon-feedback { color: #ab6b63; background: #fff0e9; }
.mine-icon-legal { color: #88799b; background: #f2eafa; }
.mine-row-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.mine-row-title { color: var(--ink-2); font-family: var(--display); font-size: 21rpx; font-weight: 600; }
.mine-row-desc { margin-top: 1rpx; color: var(--ink-3); font-size: 16rpx; }
.mine-row-arrow { color: #c28a83; font-size: 22rpx; }
.mine-footnote { display: flex; align-items: flex-start; margin-top: 24rpx; padding: 16rpx 17rpx; color: var(--ink-3); background: #fff9f4; border-radius: 17rpx; font-size: 16rpx; line-height: 1.6; }
.mine-footnote-mark { display: flex; flex: 0 0 27rpx; align-items: center; justify-content: center; width: 27rpx; height: 27rpx; margin: 1rpx 10rpx 0 0; color: #a17a75; background: #f8e7df; border-radius: 50%; font-family: Georgia, serif; font-size: 17rpx; }
.mine-signature { display: flex; align-items: center; justify-content: center; padding: 26rpx 0 15rpx; color: #b2a5a9; font-family: var(--mono); font-size: 12rpx; letter-spacing: 1.5rpx; }
.mine-signature text + text { margin-left: 9rpx; color: #d29a91; }
.tab-safe-bottom { height: calc(env(safe-area-inset-bottom) + 118rpx); }
