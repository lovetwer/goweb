/* pages/detail/detail.wxss —— 黑白灰为主，红只用于分类角标 / 已收藏 / 复制反馈 */

/* ================= 大图 ================= */
.hero {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
  background: var(--black);
}

.hero-img {
  width: 100%;
  height: 500rpx;
  display: block;
}

.hero-fallback {
  width: 100%;
  height: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-initial {
  font-size: 180rpx;
  font-weight: 800;
  line-height: 1;
  color: #262626;
}

.hero-fallback-tip {
  margin-top: 20rpx;
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #4d4d4d;
}

/* 底部压暗，保证角标可读 */
.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(12, 12, 12, 0) 0%, rgba(12, 12, 12, 0.55) 100%);
  pointer-events: none;
}

/* 分类角标：唯一的红色块 */
.hero-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 12rpx 28rpx;
  background: var(--red);
  border-radius: 0 var(--radius) 0 0;
}

.hero-badge-text {
  font-size: 23rpx;
  color: #fff;
  letter-spacing: 3rpx;
  font-weight: 600;
}

/* 右上角收藏 */
.hero-fav {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-fav-on {
  background: var(--red);
}

/* CSS 书签（大） */
.bm-icon-lg {
  width: 26rpx;
  height: 34rpx;
  background: var(--black);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
}

.hero-fav-on .bm-icon-lg {
  background: #fff;
}

/* ================= 内容区 ================= */
.detail-body {
  position: relative;
  margin-top: -32rpx;
  padding-bottom: 220rpx;
  z-index: 2;
}

.sheet {
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 30rpx;
}

.sheet-dark {
  background: var(--black);
}

.sheet-head {
  padding-bottom: 8rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-no {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-4);
}

.head-date {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.site-name {
  display: block;
  margin-top: 18rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: -0.5rpx;
  color: var(--black);
  word-break: break-all;
}

/* 红 + 灰 双段分隔线 */
.head-rule {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.head-rule-red {
  width: 88rpx;
  height: 6rpx;
  background: var(--red);
}

.head-rule-grey {
  flex: 1;
  height: 2rpx;
  background: var(--line-2);
}

.site-host {
  display: block;
  margin-top: 18rpx;
  font-family: var(--mono);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--ink-2);
  word-break: break-all;
}

/* ================= 区块 ================= */
.section {
  margin-top: 44rpx;
}

.section-label {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.label-mark {
  width: 10rpx;
  height: 10rpx;
  background: var(--black);
  margin-right: 12rpx;
  transform: translateY(-4rpx);
}

.label-text {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--black);
  letter-spacing: 2rpx;
}

.label-en {
  margin-left: 14rpx;
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

.site-desc {
  display: block;
  padding: 30rpx 28rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 29rpx;
  line-height: 1.95;
  color: var(--ink-2);
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

/* ================= 网址 ================= */
.url-box {
  position: relative;
  padding: 28rpx 28rpx 28rpx 34rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.url-box::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--black);
}

.url-host {
  display: block;
  font-family: var(--mono);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--black);
  word-break: break-all;
}

.url-full {
  display: block;
  margin-top: 12rpx;
  font-family: var(--mono);
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--ink-3);
  word-break: break-all;
}

.url-hint {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.url-hint-text {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-4);
}

/* ================= 页脚 ================= */
.sheet-foot {
  margin-top: 52rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
  text-align: center;
}

.foot-text {
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-4);
}

/* ================= 底部操作栏 ================= */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 2rpx solid var(--line);
  z-index: 20;
}

.action-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 92rpx;
  border: 2rpx solid var(--line-2);
  border-radius: var(--radius);
  background: var(--card);
  flex-shrink: 0;
}

.action-fav-on {
  border-color: var(--red);
  background: var(--red-soft);
}

.action-fav-on .bm-icon-lg {
  background: var(--red);
}

.action-fav-text {
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.action-fav-on .action-fav-text {
  color: var(--red-deep);
}

.action-copy {
  flex: 1;
  height: 92rpx;
  margin-left: 18rpx;
  border-radius: var(--radius);
  background: var(--black);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 复制成功：唯一的红色反馈 */
.action-copy-done {
  background: var(--red);
}

.action-copy-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 6rpx;
}

/* ================= 骨架屏 ================= */
.sk-hero {
  width: 100%;
  height: 500rpx;
  border-radius: 0;
  background: #1c1c1c;
}

.sk-line {
  height: 26rpx;
  margin-top: 20rpx;
  border-radius: var(--radius);
}

.sk-line-title {
  height: 52rpx;
  width: 60%;
  margin-top: 0;
}

.sk-line-short {
  width: 42%;
}

/* ================= 深色版式（封面缺失时，与黑底大图连成一片） ================= */
.sheet-dark .head-no,
.sheet-dark .head-date {
  color: #6f6f6f;
}

.sheet-dark .site-name {
  color: #ffffff;
}

.sheet-dark .head-rule-grey {
  background: #333333;
}

.sheet-dark .site-host {
  color: #b4b3af;
}

.sheet-dark .label-text {
  color: #ffffff;
}

.sheet-dark .label-en {
  color: #6f6f6f;
}

.sheet-dark .site-desc,
.sheet-dark .url-box {
  background: #171717;
  border-color: #2b2b2b;
  color: #c8c7c3;
}

.sheet-dark .url-box::before {
  background: var(--red);
}

.sheet-dark .url-host {
  color: #ffffff;
}

.sheet-dark .url-full {
  color: #8b8a86;
}

.sheet-dark .url-hint {
  border-top-color: #2b2b2b;
}

.sheet-dark .url-hint-text,
.sheet-dark .foot-text {
  color: #6f6f6f;
}

.sheet-dark .sheet-foot {
  border-top-color: #2b2b2b;
}
