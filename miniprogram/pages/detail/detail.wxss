/* pages/detail/detail.wxss
   浅色版式：白底为主，黑用于标题与主按钮，灰用于文字与发丝线，
   红只出现在「分类小方块」「已收藏书签」「复制成功反馈」三处（全站 7 处红之三）。 */

/* ================= 大图 ================= */
.hero {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  background: var(--fill);
  border-bottom: 2rpx solid var(--line);
}

.hero-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.hero-fallback {
  width: 100%;
  height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--fill);
}

.hero-initial {
  font-size: 170rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--line-2);
}

.hero-fallback-tip {
  margin-top: 22rpx;
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--ink-4);
}

/* 底部淡淡压白，让内容与大图之间有过渡 */
.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.6) 100%);
  pointer-events: none;
}

/* 右上角收藏：白底圆形 + 黑色书签 */
.hero-fav {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--white);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 红 5/7：已收藏（大图上的书签按钮） */
.hero-fav-on {
  background: var(--red-soft);
  border-color: var(--red);
}

/* CSS 书签（大） */
.bm-icon-lg {
  width: 26rpx;
  height: 34rpx;
  background: var(--black);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
}

.hero-fav-on .bm-icon-lg {
  background: var(--red);
}

/* ================= 内容区 ================= */
.detail-body {
  position: relative;
  background: var(--white);
  padding-bottom: 230rpx;
}

.sheet {
  background: var(--white);
  padding: 40rpx 32rpx 30rpx;
}

.sheet-head {
  padding-bottom: 6rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-cat {
  display: flex;
  align-items: center;
}

/* 红 3/7：分类小方块 */
.cat-mark {
  width: 12rpx;
  height: 12rpx;
  background: var(--red);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.cat-text {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--black);
}

.head-date {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-4);
}

.site-name {
  display: block;
  margin-top: 22rpx;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: -0.5rpx;
  color: var(--black);
  word-break: break-all;
}

.head-rule {
  height: 2rpx;
  background: var(--line);
  margin-top: 30rpx;
}

.head-meta {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.meta-label {
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.site-host {
  flex: 1;
  min-width: 0;
  font-family: var(--mono);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--ink-2);
  word-break: break-all;
}

/* ================= 区块 ================= */
.section {
  margin-top: 48rpx;
}

.section-label {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--black);
  letter-spacing: 2rpx;
}

.label-en {
  margin-left: 14rpx;
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

.site-desc {
  display: block;
  padding: 30rpx 28rpx;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  font-size: 29rpx;
  line-height: 1.95;
  color: var(--ink-2);
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

/* ================= 网址 ================= */
.url-box {
  position: relative;
  padding: 28rpx 28rpx 28rpx 34rpx;
  background: var(--white);
  border: 2rpx solid var(--line-2);
  border-radius: var(--radius);
  overflow: hidden;
}

.url-box::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--black);
}

.url-host {
  display: block;
  font-family: var(--mono);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--black);
  word-break: break-all;
}

.url-full {
  display: block;
  margin-top: 12rpx;
  font-family: var(--mono);
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--ink-3);
  word-break: break-all;
}

.url-hint {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line-2);
}

.url-hint-text {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-4);
}

/* ================= 页脚 ================= */
.sheet-foot {
  margin-top: 56rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--line);
  text-align: center;
}

.foot-text {
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-4);
}

/* ================= 底部操作栏 ================= */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 2rpx solid var(--line);
  z-index: 20;
}

.action-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 92rpx;
  border: 2rpx solid var(--line-2);
  border-radius: var(--radius);
  background: var(--white);
  flex-shrink: 0;
}

/* 红 5/7：已收藏（底部操作栏） */
.action-fav-on {
  border-color: var(--red);
  background: var(--red-soft);
}

.action-fav-on .bm-icon-lg {
  background: var(--red);
}

.action-fav-text {
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.action-fav-on .action-fav-text {
  color: var(--red-deep);
}

.action-copy {
  flex: 1;
  height: 92rpx;
  margin-left: 18rpx;
  border-radius: var(--radius);
  background: var(--black);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 红 6/7：复制成功的瞬时反馈 */
.action-copy-done {
  background: var(--red);
}

.action-copy-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--white);
  letter-spacing: 6rpx;
}

/* ================= 骨架屏 ================= */
.sk-hero {
  width: 100%;
  height: 480rpx;
  border-radius: 0;
}

.sk-line {
  height: 26rpx;
  margin-top: 20rpx;
  border-radius: var(--radius);
}

.sk-line-title {
  height: 54rpx;
  width: 60%;
  margin-top: 0;
}

.sk-line-short {
  width: 42%;
}
