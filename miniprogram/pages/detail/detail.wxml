<!--pages/detail/detail.wxml  详情页：大图 + 网站名 + 分类 + 完整简介 + 复制网址 + 本地收藏-->
<view class="container">

  <!-- 加载中 -->
  <block wx:if="{{loading}}">
    <view class="sk-hero skeleton"></view>
    <view class="detail-body">
      <view class="sheet">
        <view class="sk-line sk-line-title skeleton"></view>
        <view class="sk-line skeleton"></view>
        <view class="sk-line skeleton"></view>
        <view class="sk-line sk-line-short skeleton"></view>
      </view>
    </view>
  </block>

  <!-- 错误 / 不存在 -->
  <view wx:elif="{{errorText}}" class="state-box">
    <view class="state-icon state-icon-warn">!</view>
    <text class="state-index">ERROR</text>
    <text class="state-title">没能打开这条收录</text>
    <text class="state-desc">{{errorText}}</text>
    <view class="state-actions">
      <view class="state-btn ghost" hover-class="btn-hover" bindtap="onRetry">重新加载</view>
      <view class="state-btn" hover-class="btn-hover" bindtap="onBackHome">回到首页</view>
    </view>
  </view>

  <!-- 正常内容 -->
  <block wx:elif="{{site}}">

    <!-- 大图 -->
    <view class="hero">
      <image
        wx:if="{{site.hasCover && !coverFailed}}"
        class="hero-img"
        src="{{site.coverUrl}}"
        mode="aspectFill"
        binderror="onCoverError"
        bindtap="onPreviewCover"
      />
      <view wx:else class="hero-fallback">
        <text class="hero-initial">{{site.initial}}</text>
        <text class="hero-fallback-tip">NO COVER</text>
      </view>
      <view class="hero-shade"></view>

      <!-- 分类角标 -->
      <view class="hero-badge">
        <text class="hero-badge-text">{{site.category}}</text>
      </view>

      <!-- 收藏按钮 -->
      <view
        class="hero-fav {{isFavorite ? 'hero-fav-on' : ''}}"
        hover-class="btn-hover"
        bindtap="onToggleFavorite"
      >
        <view class="bm-icon-lg"></view>
      </view>
    </view>

    <view class="detail-body">
      <view class="sheet {{coverFailed || !site.hasCover ? 'sheet-dark' : ''}}">

        <!-- 标题区 -->
        <view class="sheet-head">
          <view class="head-top">
            <text class="head-no">收录编号</text>
            <text class="head-date" wx:if="{{site.timeText}}">{{site.timeText}}</text>
          </view>
          <text class="site-name">{{site.name}}</text>
          <view class="head-rule">
            <view class="head-rule-red"></view>
            <view class="head-rule-grey"></view>
          </view>
          <text class="site-host">{{site.hostText}}</text>
        </view>

        <!-- 完整简介 -->
        <view class="section">
          <view class="section-label">
            <text class="label-mark"></text>
            <text class="label-text">网站简介</text>
            <text class="label-en">DESCRIPTION</text>
          </view>
          <text class="site-desc">{{site.description}}</text>
        </view>

        <!-- 网址：只展示 + 只复制，无任何跳转 -->
        <view class="section">
          <view class="section-label">
            <text class="label-mark"></text>
            <text class="label-text">网站地址</text>
            <text class="label-en">URL</text>
          </view>
          <view class="url-box" bindlongpress="onUrlLongPress">
            <text class="url-host">{{site.hostText}}</text>
            <text class="url-full">{{site.url}}</text>
            <view class="url-hint">
              <text class="url-hint-text">长按可复制</text>
            </view>
          </view>
        </view>

        <view class="sheet-foot">
          <text class="foot-text">本页面仅提供信息展示与网址复制</text>
        </view>

      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar">
      <view
        class="action-fav {{isFavorite ? 'action-fav-on' : ''}}"
        hover-class="btn-hover"
        bindtap="onToggleFavorite"
      >
        <view class="bm-icon-lg"></view>
        <text class="action-fav-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-copy {{copied ? 'action-copy-done' : ''}}" hover-class="btn-hover" bindtap="onCopyUrl">
        <text class="action-copy-text">{{copied ? '网址已复制' : '复制网址'}}</text>
      </view>
    </view>

  </block>

</view>
