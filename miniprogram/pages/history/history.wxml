<!--pages/history/history.wxml  使用记录：全部来自本地 Storage，记录对象是工具-->
<view class="container">

  <view class="hist-header">
    <view class="hist-head-top">
      <text class="hist-kicker">RECENTLY USED</text>
      <view wx:if="{{count > 0}}" class="hist-clear" hover-class="btn-hover" bindtap="onClearAll">
        <text class="hist-clear-text">清空</text>
      </view>
    </view>
    <view class="hist-title-row">
      <text class="hist-title">使用记录</text>
      <text class="hist-num">{{countText}}</text>
    </view>
    <view class="hist-rule">
      <view class="hist-rule-mark"></view>
      <view class="hist-rule-grey"></view>
    </view>
    <text class="hist-sub">仅保存在本机，不上传服务器</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && count === 0}}" class="state-box">
    <view class="state-icon">·</view>
    <text class="state-index">EMPTY</text>
    <text class="state-title">还没有使用记录</text>
    <text class="state-desc">用过的工具会自动出现在这里</text>
    <view class="state-actions">
      <view class="state-btn" hover-class="btn-hover" bindtap="onGoIndex">去逛逛</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:else class="hist-list">
    <view
      class="hist-item fade-in {{item.alive ? '' : 'hist-item-dead'}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="hist-item-hover"
      bindtap="onItemTap"
    >
      <view class="hist-icon" style="background:{{item.soft}};color:{{item.color}}">{{item.icon}}</view>

      <view class="hist-body">
        <view class="hist-name-row">
          <text class="hist-name ellipsis">{{item.name}}</text>
          <text wx:if="{{!item.alive}}" class="hist-dead-tag">已下架</text>
          <text class="hist-arrow">→</text>
        </view>
        <text class="hist-desc ellipsis-2">{{item.desc}}</text>
        <view class="hist-meta">
          <view wx:if="{{item.categoryName}}" class="hist-tag">
            <text class="hist-tag-dot"></text>
            <text class="hist-tag-text">{{item.categoryName}}</text>
          </view>
          <text class="hist-time">{{item.timeText}}</text>
        </view>
      </view>

      <view class="hist-remove" hover-class="btn-hover" catchtap="onRemove" data-id="{{item.id}}">
        <view class="rm-x"></view>
        <view class="rm-y"></view>
      </view>
    </view>

    <view wx:if="{{count > 0}}" class="hist-count">
      <view class="hist-count-line"></view>
      <text class="hist-count-text">共 {{count}} 条</text>
      <view class="hist-count-line"></view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
