<view class="home-page">
  <view class="home-content">
    <view class="search-wrap">
      <view class="search-bar {{searchFocus ? 'search-bar-focus' : ''}}">
        <view class="search-loupe"></view>
        <input class="search-input" type="text" value="{{keyword}}" placeholder="找一个小工具…" placeholder-class="search-placeholder" confirm-type="search" cursor-spacing="20" cursor-color="#ee9d8a" bindinput="onSearchInput" bindconfirm="onSearchConfirm" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
        <view wx:if="{{keyword}}" class="search-clear" hover-class="btn-hover" catchtap="onClearKeyword"><text>×</text></view>
        <text wx:else class="search-hint">搜索</text>
      </view>
    </view>

    <view wx:if="{{keyword}}" class="search-results fade-in">
      <view class="results-heading">
        <view><text class="section-kicker">SEARCH / {{results.length < 10 ? '0' + results.length : results.length}}</text><text class="results-title">和「{{keyword}}」有关</text></view>
        <text class="result-reset" hover-class="btn-hover" bindtap="onReset">清空 ×</text>
      </view>
      <view wx:if="{{results.length === 0}}" class="empty-search">
        <view class="empty-search-mark">?</view><text class="empty-search-title">暂时没有找到</text><text class="empty-search-desc">试着换个词，日常的小帮手还在慢慢添置。</text>
        <view class="search-return" hover-class="btn-hover" bindtap="onReset">回到首页 <text>↗</text></view>
      </view>
      <view wx:else class="result-list">
        <view wx:for="{{results}}" wx:key="id" class="result-card" data-id="{{item.id}}" hover-class="result-card-hover" bindtap="onToolTap">
          <image wx:if="{{item.image}}" class="result-art" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="result-initial" style="background:{{item.soft}};color:{{item.color}}">{{item.initial}}</view>
          <view class="result-copy"><text class="result-category">{{item.categoryName}} · {{item.vipOnly ? '会员工具' : '随时可用'}}</text><text class="result-name">{{item.name}}</text><text class="result-desc ellipsis-2">{{item.desc}}</text></view>
          <view class="result-arrow">↗</view>
        </view>
      </view>
    </view>

    <block wx:else>
      <view class="home-tool-link" hover-class="home-tool-link-hover" bindtap="onGoTools">
        <view class="home-tool-mark"><view></view><view></view><view></view><view></view></view>
        <view class="home-tool-copy"><text class="home-tool-kicker">YOUR LITTLE TOOL SHELF · {{toolTotal < 10 ? '0' + toolTotal : toolTotal}}</text><text class="home-tool-title">看看全部工具</text><text class="home-tool-desc">按分类慢慢挑一个趁手的小帮手</text></view>
        <view class="home-tool-arrow">↗</view>
      </view>

      <view wx:if="{{recent.length > 0}}" class="recent-shelf">
        <view class="recent-heading"><view><text class="section-kicker">PICK UP WHERE YOU LEFT</text><text class="recent-title">刚刚用过</text></view><text class="recent-count mono">{{recent.length < 10 ? '0' + recent.length : recent.length}}</text></view>
        <scroll-view class="recent-scroller" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="recent-row">
            <view wx:for="{{recent}}" wx:key="id" class="recent-note" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onRecentTap">
              <image wx:if="{{item.image}}" class="recent-thumb" src="{{item.image}}" mode="aspectFill" />
              <view wx:else class="recent-thumb recent-thumb-initial" style="background:{{item.soft}};color:{{item.color}}">{{item.icon}}</view>
              <view class="recent-note-bottom"><text class="recent-name ellipsis">{{item.name}}</text><text class="recent-note-arrow">↗</text></view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{featuredTool}}" class="home-pick">
        <view class="home-pick-heading"><view><text class="section-kicker">A LITTLE SOMETHING TO TRY</text><text class="home-pick-title">今天也可以试试</text></view><text class="home-pick-index">01</text></view>
        <view class="home-feature" data-id="{{featuredTool.id}}" hover-class="feature-tool-hover" bindtap="onToolTap">
          <view class="home-feature-copy"><text class="home-feature-kicker">{{featuredTool.categoryName}} · DAILY PICK</text><text class="home-feature-name">{{featuredTool.name}}</text><text class="home-feature-desc ellipsis-2">{{featuredTool.desc}}</text><view class="home-feature-action"><text>开始探索</text><view>↗</view></view></view>
          <image wx:if="{{featuredTool.image}}" class="home-feature-art" src="{{featuredTool.image}}" mode="aspectFill" />
          <view wx:else class="home-feature-art home-feature-fallback" style="background:{{featuredTool.soft}};color:{{featuredTool.color}}">{{featuredTool.initial}}</view>
        </view>
      </view>

      <view wx:if="{{!featuredTool}}" class="home-empty"><view class="empty-search-mark">✳</view><text class="empty-search-title">工具正在路上</text><text class="empty-search-desc">小小的实用工具会慢慢到来。</text></view>
    </block>
  </view>
  <view class="tab-safe-bottom"></view>
</view>
