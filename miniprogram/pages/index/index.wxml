<view class="home-page">
  <view class="hero-shell">
    <view class="masthead">
      <view class="brand-line">
        <view class="brand-stamp"><text>日</text></view>
        <view class="brand-caption"><text class="brand-kicker">THE LITTLE DAYBOOK</text><text class="brand-subtitle">A quiet place for useful things</text></view>
        <view class="brand-edition">VOL. 01</view>
      </view>
      <view class="hero-copy">
        <text class="hero-overline">轻一点，也好用一点</text>
        <view class="hero-title"><text>把日常，</text><text>整理得刚刚好。</text></view>
        <text class="hero-description">在忙碌的缝隙里，留几个顺手的小工具。</text>
      </view>
      <image class="hero-art" src="../../assets/illustrations/home-bloom.png" mode="aspectFit" />
      <view class="hero-footer"><view class="hero-footer-dot"></view><text>打开即用</text><view class="hero-footer-rule"></view><text>无需登录</text><text class="hero-edition-mobile">A LITTLE TOOLKIT</text></view>
    </view>
  </view>

  <view class="home-content">
    <view class="search-wrap">
      <view class="search-bar {{searchFocus ? 'search-bar-focus' : ''}}">
        <view class="search-loupe"></view>
        <input class="search-input" type="text" value="{{keyword}}" placeholder="找一个小工具…" placeholder-class="search-placeholder" confirm-type="search" cursor-spacing="20" cursor-color="#a97079" bindinput="onSearchInput" bindconfirm="onSearchConfirm" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
        <view wx:if="{{keyword}}" class="search-clear" hover-class="btn-hover" catchtap="onClearKeyword"><text>×</text></view>
        <text wx:else class="search-hint">搜索</text>
      </view>
    </view>

    <view wx:if="{{keyword}}" class="search-results fade-in">
      <view class="results-heading">
        <view><text class="section-kicker">SEARCH / {{results.length < 10 ? '0' + results.length : results.length}}</text><text class="results-title">和「{{keyword}}」有关</text></view>
        <text class="result-reset" hover-class="btn-hover" bindtap="onReset">清空 ×</text>
      </view>
      <view wx:if="{{results.length === 0}}" class="empty-search">
        <view class="empty-search-mark">?</view><text class="empty-search-title">暂时没有找到</text><text class="empty-search-desc">试着换个词，日常的小帮手还在慢慢添置。</text>
        <view class="search-return" hover-class="btn-hover" bindtap="onReset">回到工具架 <text>↗</text></view>
      </view>
      <view wx:else class="result-list">
        <view wx:for="{{results}}" wx:key="id" class="result-card" data-id="{{item.id}}" hover-class="result-card-hover" bindtap="onToolTap">
          <image wx:if="{{item.image}}" class="result-art" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="result-initial" style="background:{{item.soft}};color:{{item.color}}">{{item.initial}}</view>
          <view class="result-copy"><text class="result-category">{{item.categoryName}} · {{item.vipOnly ? '会员工具' : '随时可用'}}</text><text class="result-name">{{item.name}}</text><text class="result-desc ellipsis-2">{{item.desc}}</text></view>
          <view class="result-arrow">↗</view>
        </view>
      </view>
    </view>

    <block wx:else>
      <view wx:if="{{toolTotal === 0}}" class="empty-tools">
        <view class="empty-ornament">✳</view><text class="section-kicker">A NEW PAGE IS COMING</text><text class="empty-tools-title">工具正在路上</text><text class="empty-tools-desc">小小的实用工具会慢慢到来，<text>先在这里歇一会儿吧。</text></text>
      </view>

      <block wx:else>
        <view wx:if="{{recent.length > 0}}" class="recent-shelf">
          <view class="recent-heading"><view><text class="section-kicker">PICK UP WHERE YOU LEFT</text><text class="recent-title">刚刚用过</text></view><text class="recent-count mono">{{recent.length < 10 ? '0' + recent.length : recent.length}}</text></view>
          <scroll-view class="recent-scroller" scroll-x="true" enhanced="true" show-scrollbar="false">
            <view class="recent-row">
              <view wx:for="{{recent}}" wx:key="id" class="recent-note" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onRecentTap">
                <image wx:if="{{item.image}}" class="recent-thumb" src="{{item.image}}" mode="aspectFill" />
                <view wx:else class="recent-thumb recent-thumb-initial" style="background:{{item.soft}};color:{{item.color}}">{{item.icon}}</view>
                <view class="recent-note-bottom"><text class="recent-name ellipsis">{{item.name}}</text><text class="recent-note-arrow">↗</text></view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="toolshelf-head">
          <view><text class="section-kicker">YOUR LITTLE TOOL SHELF</text><text class="toolshelf-title">慢慢挑，慢慢用</text></view>
          <view class="toolshelf-total"><text class="toolshelf-total-no">{{toolTotal < 10 ? '0' + toolTotal : toolTotal}}</text><text class="toolshelf-total-label">TOOLS</text></view>
        </view>

        <view class="sections">
          <view wx:for="{{sections}}" wx:for-item="sec" wx:key="key" class="tool-section">
            <view class="category-heading"><view class="category-index"><text class="category-index-dot" style="background:{{sec.color}}"></text><text>{{sec.en}}</text></view><text class="category-name">{{sec.name}}</text><view class="category-heading-rule"></view><text class="category-count">{{sec.tools.length}} 件</text></view>
            <view wx:for="{{sec.tools}}" wx:key="id" class="feature-tool fade-in" data-id="{{item.id}}" hover-class="feature-tool-hover" hover-stay-time="80" bindtap="onToolTap">
              <view class="feature-copy"><text class="feature-serial">NO. {{item.no < 10 ? '0' + item.no : item.no}} <text> / {{sec.en}}</text></text><text class="feature-name">{{item.name}}</text><text class="feature-desc ellipsis-2">{{item.desc}}</text><view class="feature-action"><text>开始探索</text><view class="feature-action-arrow">↗</view></view></view>
              <image wx:if="{{item.image}}" class="feature-art" src="{{item.image}}" mode="aspectFill" />
              <view wx:else class="feature-art-fallback" style="background:{{item.soft}};color:{{item.color}}">{{item.initial}}</view>
              <view class="feature-card-index">{{item.no < 10 ? '0' + item.no : item.no}}</view>
            </view>
          </view>
        </view>

        <view class="quick-links">
          <view class="quick-link-head"><text class="section-kicker">KEEP CLOSE</text><text class="quick-link-title">你的私人角落</text></view>
          <view class="quick-grid">
            <view class="quick-card quick-favorites" hover-class="quick-card-hover" bindtap="onFavEntryTap"><image class="quick-art" src="../../assets/illustrations/shortcut-favorites.png" mode="aspectFill"/><view class="quick-card-copy"><text class="quick-en">SAVED NOTES</text><text class="quick-title">收藏夹</text><text class="quick-desc">{{favCount}} 件收好的小事</text></view><text class="quick-arrow">↗</text></view>
            <view class="quick-card quick-history" hover-class="quick-card-hover" bindtap="onHistoryTap"><image class="quick-art" src="../../assets/illustrations/shortcut-history.png" mode="aspectFill"/><view class="quick-card-copy"><text class="quick-en">LITTLE ARCHIVE</text><text class="quick-title">使用记录</text><text class="quick-desc">{{histCount}} 条最近足迹</text></view><text class="quick-arrow">↗</text></view>
          </view>
        </view>

        <view wx:if="{{vipEnabled}}" class="membership-note" hover-class="membership-note-hover" bindtap="onVipTap"><image class="membership-art" src="../../assets/illustrations/shortcut-vip.png" mode="aspectFill"/><view class="membership-copy"><text class="membership-en">A LITTLE MORE, IF YOU LIKE</text><text class="membership-title">{{isMember ? '谢谢你成为会员' : '给喜欢的工具，多一点空间'}}</text><text class="membership-desc">看看会员权益与开通说明 <text>↗</text></text></view><view class="membership-stamp">✳</view></view>
      </block>
    </block>

    <view class="quiet-note" hover-class="btn-hover" bindtap="onLegalTap"><view class="quiet-note-mark">✳</view><view><text class="quiet-note-title">收藏与历史，只保存在这台设备里</text><text class="quiet-note-desc">会员与反馈数据依隐私说明处理 · 查看隐私政策 ↗</text></view></view>
    <view class="footer-links"><text class="footer-copyright">© LITTLE DAYBOOK</text><view class="footer-link-group"><text hover-class="btn-hover" bindtap="onLegalTap">隐私与使用说明</text><text class="footer-dot">·</text><text hover-class="btn-hover" bindtap="onFeedbackTap">写一封反馈</text></view></view>
  </view>
  <view class="safe-bottom"></view>
</view>
