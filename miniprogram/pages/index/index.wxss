/* pages/index/index.wxss */

/* ---------------- 顶部 ---------------- */
.header {
  padding: 24rpx 32rpx 20rpx;
  background: var(--bg);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #4c86ff 0%, #2f5fe0 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(61, 127, 255, 0.28);
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  min-width: 0;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--ink);
}

.brand-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.fav-entry {
  position: relative;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}

.fav-entry-hover {
  background: #f2f4f7;
}

/* CSS 画的五角星，避免不同机型 emoji 渲染差异 */
.fav-star {
  width: 26rpx;
  height: 26rpx;
  background: #f5a623;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
  flex-shrink: 0;
}

.fav-label {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-left: 10rpx;
}

.fav-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* ---------------- 搜索框 ---------------- */
.search-bar {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  box-shadow: 0 4rpx 16rpx rgba(28, 29, 33, 0.03);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-bar-focus {
  border-color: rgba(61, 127, 255, 0.55);
  box-shadow: 0 0 0 6rpx rgba(61, 127, 255, 0.08);
}

/* CSS 画的放大镜 */
.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #b4b9c2;
  border-radius: 50%;
  margin: 0 20rpx 6rpx 4rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #b4b9c2;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: #b4b9c2;
  font-size: 28rpx;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #e9ebef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.search-clear-hover {
  background: #dcdfe5;
}

.search-clear-x {
  font-size: 30rpx;
  color: #7a808c;
  line-height: 1;
  margin-top: -4rpx;
}

/* ---------------- 分类 Tab ---------------- */
.tabs {
  width: 100%;
  white-space: nowrap;
  background: var(--bg);
  padding: 6rpx 0 18rpx;
}

.tabs-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
}

.tab {
  flex-shrink: 0;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  color: var(--ink-2);
  font-size: 26rpx;
  transition: all 0.18s ease;
}

.tab-hover {
  background: #f2f4f7;
}

.tab-active {
  background: var(--brand);
  border-color: var(--brand);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(61, 127, 255, 0.26);
}

.tab-active.tab-hover {
  background: #3573ee;
}

/* ---------------- 结果统计 ---------------- */
.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 36rpx 14rpx;
}

.result-text {
  font-size: 23rpx;
  color: var(--ink-3);
}

.result-reset {
  font-size: 23rpx;
  color: var(--brand);
}

/* ---------------- 卡片列表 ---------------- */
.list {
  padding: 0 24rpx;
}

.site-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(28, 29, 33, 0.04);
}

.site-card-hover {
  background: #fafbfc;
  transform: scale(0.992);
}

.cover-wrap {
  position: relative;
  width: 176rpx;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef0f4;
}

.cover {
  width: 176rpx;
  height: 132rpx;
  display: block;
}

.cover-fallback {
  width: 176rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-initial {
  font-size: 56rpx;
  font-weight: 600;
  color: rgba(28, 29, 33, 0.28);
}

.site-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  padding-right: 26rpx;
}

.site-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.3rpx;
}

.site-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
  line-height: 1.5;
}

.site-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.55;
}

.site-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.site-url {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--ink-3);
}

.site-time {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #c2c7d0;
}

.site-arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-58%);
  font-size: 40rpx;
  color: #d8dce3;
  line-height: 1;
}

/* ---------------- 加载状态 ---------------- */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 8rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--ink-3);
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border: 4rpx solid #dfe3ea;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.load-end {
  padding: 32rpx 0 8rpx;
  text-align: center;
}

.load-end-text {
  font-size: 22rpx;
  color: #c2c7d0;
}

.btn-hover {
  opacity: 0.85;
}

/* ---------------- 骨架屏 ---------------- */
.sk-cover {
  width: 176rpx;
  height: 132rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.sk-line {
  height: 24rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
}

.sk-line-title {
  height: 32rpx;
  width: 45%;
  margin-top: 0;
}

.sk-line-short {
  width: 65%;
}
