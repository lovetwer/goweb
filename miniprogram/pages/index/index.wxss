/* pages/index/index.wxss —— 工具箱首页（暖纸版式：暖白底 + 白卡片 + 陶土红点缀） */

/* ================= 顶部 ================= */
.header {
  padding: 24rpx 32rpx 28rpx;
  background: var(--bg);
  border-bottom: 2rpx solid var(--line);
}

/* 刊头：编号行 */
.issue-row {
  display: flex;
  align-items: center;
}

/* 刊头圆点（陶土红）：14rpx 实心点 + 一圈同色柔光，页面顶部视觉锚点 */
.issue-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 6rpx var(--red-soft);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.issue-no {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

/* 入口栏：历史 / 收藏 / 会员 / 反馈，四等分 */
.entry-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 4rpx 0;
}

.issue-entry {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.issue-entry-text {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
}

/* 「反馈」/ 已会员状态：浅陶土底标签（不催促、不诱导） */
.entry-text-hl {
  padding: 4rpx 18rpx;
  background: var(--red-soft);
  border: 2rpx solid var(--red-line);
  border-radius: 999rpx;
  color: var(--red-deep);
  font-size: 24rpx;
}

.entry-badge {
  margin-left: 10rpx;
  min-width: 30rpx;
  padding: 0 8rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: var(--red-soft);
  border-radius: 999rpx;
  font-family: var(--mono);
  font-size: 19rpx;
  color: var(--red-deep);
}

.entry-div {
  width: 2rpx;
  height: 26rpx;
  background: var(--line);
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 24rpx;
  height: 84rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  transition: border-color 0.18s ease;
}

.search-bar-focus {
  border-color: var(--red);
}

.search-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid var(--ink-4);
  border-radius: 50%;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--ink-4);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  margin-left: 18rpx;
  font-size: 27rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-4);
}

.search-clear {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.clear-x,
.clear-y {
  position: absolute;
  left: 8rpx;
  top: 21rpx;
  width: 26rpx;
  height: 3rpx;
  background: var(--ink-3);
  border-radius: 2rpx;
}

.clear-x {
  transform: rotate(45deg);
}

.clear-y {
  transform: rotate(-45deg);
}

/* ================= 最近使用 ================= */
.recent {
  padding: 30rpx 0 6rpx;
}

.recent-head {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

/* 「最近使用」标题前的陶土红竖条：与分区标题同一套语汇 */
.recent-mark {
  width: 8rpx;
  height: 28rpx;
  background: var(--red);
  border-radius: 2rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--black);
}

.recent-en {
  margin-left: auto;
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

.recent-row {
  margin-top: 20rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.recent-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 10rpx 22rpx 10rpx 10rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.recent-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.recent-name {
  max-width: 150rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ================= 分类分区 ================= */
.sections {
  padding: 6rpx 24rpx 0;
}

.section {
  margin-top: 30rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

/* 分区标题前的分类色竖条（8×28rpx，与文字行高对齐） */
.sec-mark {
  width: 8rpx;
  height: 28rpx;
  border-radius: 2rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.sec-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--black);
}

.sec-en {
  margin-left: auto;
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

/* ================= 工具卡片网格（两列） ================= */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.tool-card {
  display: flex;
  align-items: flex-start;
  width: 48.6%;
  padding: 22rpx 20rpx;
  margin-bottom: 18rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.tool-card-hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-2rpx);
}

/* 工具图标：分类浅底 + 分类色字符 */
.tool-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tool-body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.tool-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--black);
  line-height: 1.3;
}

.tool-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

/* ================= 搜索结果 ================= */
.results {
  padding: 24rpx 24rpx 0;
}

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.result-left {
  display: flex;
  align-items: center;
}

/* 结果统计前的陶土红竖条 */
.result-bar-mark {
  width: 8rpx;
  height: 28rpx;
  background: var(--red);
  border-radius: 2rpx;
  margin-right: 14rpx;
}

.result-text {
  font-size: 25rpx;
  color: var(--ink-2);
}

.result-reset {
  font-size: 24rpx;
  color: var(--red);
}

.results .tool-grid {
  margin-top: 22rpx;
}

/* ================= 页尾 ================= */
.load-end {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0 10rpx;
}

.load-end-line {
  width: 90rpx;
  height: 2rpx;
  background: var(--line);
}

.load-end-text {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
  margin: 0 20rpx;
}

/* 底部：隐私政策与使用协议 */
.legal-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 10rpx;
}

.legal-text {
  font-size: 23rpx;
  color: var(--ink-3);
}

.legal-sep {
  margin: 0 18rpx;
  color: var(--ink-4);
}
