.home-page { min-height: 100vh; overflow: hidden; background: var(--bg); }
.home-content { position: relative; z-index: 1; padding: 16rpx 38rpx 0; }
.search-wrap { padding: 0 1rpx; }
.search-bar { display: flex; align-items: center; height: 91rpx; padding: 0 25rpx 0 29rpx; background: var(--card); border: 1rpx solid rgba(221,209,211,.82); border-radius: 25rpx; box-shadow: 0 15rpx 38rpx rgba(145,92,72,.085); transition: box-shadow .2s ease, border-color .2s ease; }
.search-bar-focus { border-color: #ed9d8a; box-shadow: 0 13rpx 38rpx rgba(238,157,138,.16); }
.search-loupe { position: relative; width: 25rpx; height: 25rpx; margin-right: 21rpx; border: 2rpx solid #91848f; border-radius: 50%; }
.search-loupe::after { content: ''; position: absolute; right: -7rpx; bottom: -4rpx; width: 10rpx; height: 2rpx; background: #91848f; border-radius: 2rpx; transform: rotate(47deg); }
.search-input { flex: 1; min-width: 0; height: 85rpx; color: var(--ink); font-size: 25rpx; letter-spacing: .4rpx; }
.search-placeholder { color: #aaa1a8; }
.search-hint { display: flex; align-items: center; justify-content: center; min-width: 53rpx; height: 42rpx; color: #9e949b; background: #fff7f1; border: 1rpx solid #f2e4dc; border-radius: 10rpx; font-family: var(--mono); font-size: 16rpx; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; color: #867983; background: #fff0e9; border-radius: 50%; font-size: 32rpx; line-height: 1; }
.search-results { padding: 53rpx 0 20rpx; }
.results-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 26rpx; }
.section-kicker { display: block; color: #a097a0; font-family: var(--mono); font-size: 17rpx; letter-spacing: 2.3rpx; }
.results-title { display: block; margin-top: 7rpx; color: var(--ink); font-family: var(--display); font-size: 34rpx; font-weight: 600; }
.result-reset { padding: 8rpx 0 7rpx 18rpx; color: var(--primary-deep); font-size: 22rpx; }
.empty-search { display: flex; flex-direction: column; align-items: center; padding: 55rpx 25rpx 58rpx; background: var(--card); border-radius: 28rpx; text-align: center; }
.empty-search-mark { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: var(--primary); background: var(--primary-soft); border: 1rpx solid var(--primary-line); border-radius: 32rpx 32rpx 32rpx 8rpx; font-family: var(--display); font-size: 42rpx; }
.empty-search-title { margin-top: 22rpx; color: var(--ink); font-family: var(--display); font-size: 31rpx; }
.empty-search-desc { max-width: 460rpx; margin-top: 8rpx; color: var(--ink-3); font-size: 22rpx; line-height: 1.7; }
.search-return { display: flex; align-items: center; margin-top: 27rpx; color: var(--primary-deep); font-size: 22rpx; }
.search-return text { margin-left: 12rpx; font-size: 27rpx; }
.result-list { display: flex; flex-direction: column; }
.result-card + .result-card { margin-top: 17rpx; }
.result-card { position: relative; display: flex; align-items: center; min-height: 167rpx; padding: 18rpx 48rpx 18rpx 18rpx; overflow: hidden; background: var(--card); border: 1rpx solid #f4e5de; border-radius: 25rpx; box-shadow: var(--shadow); }
.result-art, .result-initial { flex: 0 0 168rpx; width: 168rpx; height: 132rpx; border-radius: 17rpx; }
.result-initial { display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 41rpx; }
.result-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 20rpx; }
.result-category { color: var(--ink-4); font-family: var(--mono); font-size: 16rpx; letter-spacing: 1rpx; }
.result-name { margin-top: 3rpx; color: var(--ink); font-family: var(--display); font-size: 28rpx; font-weight: 600; }
.result-desc { margin-top: 2rpx; color: var(--ink-3); font-size: 20rpx; line-height: 1.5; }
.result-arrow { position: absolute; top: 50%; right: 18rpx; color: #c88681; font-size: 24rpx; transform: translateY(-50%); }
.result-card-hover { background: #fdf9f6; transform: translateY(-2rpx); }
.home-tool-link { position: relative; display: flex; align-items: center; min-height: 148rpx; margin-top: 26rpx; padding: 18rpx 55rpx 18rpx 19rpx; overflow: hidden; background: #fff3ec; border: 1rpx solid #f1ddd4; border-radius: 25rpx; box-shadow: 0 9rpx 22rpx rgba(151,93,75,.045); }
.home-tool-link-hover { background: #fff0e8; }
.home-tool-mark { display: flex; flex: 0 0 70rpx; flex-wrap: wrap; align-content: center; justify-content: center; width: 70rpx; height: 70rpx; margin-right: 17rpx; background: #f9dfd6; border-radius: 22rpx 22rpx 22rpx 7rpx; }
.home-tool-mark view { width: 13rpx; height: 13rpx; margin: 3rpx; background: #c57970; border-radius: 4rpx; }
.home-tool-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.home-tool-kicker { color: #ae8d86; font-family: var(--mono); font-size: 13rpx; letter-spacing: 1rpx; }
.home-tool-title { margin-top: 2rpx; color: var(--ink); font-family: var(--display); font-size: 27rpx; font-weight: 600; }
.home-tool-desc { color: var(--ink-3); font-size: 18rpx; }
.home-tool-arrow { position: absolute; top: 50%; right: 19rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; color: #fffefd; background: var(--primary-deep); border-radius: 50%; font-size: 18rpx; transform: translateY(-50%); }
.recent-shelf { padding-top: 43rpx; }
.recent-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 19rpx; }
.recent-title { display: block; margin-top: 4rpx; color: var(--ink); font-family: var(--display); font-size: 32rpx; font-weight: 600; }
.recent-count { padding-bottom: 4rpx; color: #bca39c; font-size: 19rpx; }
.recent-scroller { width: calc(100% + 38rpx); margin-left: -38rpx; white-space: nowrap; }
.recent-row { display: flex; padding: 3rpx 38rpx 13rpx; }
.recent-note { flex: 0 0 212rpx; width: 212rpx; margin-right: 17rpx; overflow: hidden; background: var(--card); border: 1rpx solid #f3e4dc; border-radius: 21rpx; box-shadow: 0 7rpx 19rpx rgba(151,93,75,.045); }
.recent-thumb { display: block; width: 100%; height: 118rpx; background: #ffe9e1; }
.recent-thumb-initial { display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 40rpx; }
.recent-note-bottom { display: flex; align-items: center; justify-content: space-between; height: 62rpx; padding: 0 14rpx; }
.recent-name { max-width: 150rpx; color: var(--ink-2); font-size: 21rpx; }
.recent-note-arrow { color: var(--primary); font-size: 22rpx; }
.home-pick { margin-top: 44rpx; }
.home-pick-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 17rpx; }
.home-pick-title { display: block; margin-top: 4rpx; color: var(--ink); font-family: var(--display); font-size: 31rpx; font-weight: 600; }
.home-pick-index { color: #c6a19b; font-family: var(--mono); font-size: 18rpx; }
.home-feature { position: relative; height: 236rpx; overflow: hidden; background: var(--card); border: 1rpx solid #f3e4dc; border-radius: 26rpx; box-shadow: var(--shadow); }
.home-feature::after { position: absolute; z-index: 1; top: 0; bottom: 0; left: 0; width: 72%; background: linear-gradient(90deg, #fffefd 0%, rgba(255,254,250,.98) 67%, rgba(255,254,250,.65) 100%); content: ''; }
.home-feature-copy { position: absolute; z-index: 2; top: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: 69%; padding: 20rpx 0 20rpx 23rpx; }
.home-feature-kicker { color: #bd9792; font-family: var(--mono); font-size: 14rpx; letter-spacing: 1rpx; }
.home-feature-name { margin-top: 5rpx; color: var(--ink); font-family: var(--display); font-size: 32rpx; font-weight: 600; }
.home-feature-desc { max-width: 350rpx; margin-top: 4rpx; color: var(--ink-3); font-size: 18rpx; line-height: 1.45; }
.home-feature-action { display: flex; align-items: center; margin-top: 10rpx; color: var(--primary-deep); font-size: 18rpx; font-weight: 600; }
.home-feature-action view { display: flex; align-items: center; justify-content: center; width: 33rpx; height: 33rpx; margin-left: 9rpx; color: #fffefd; background: var(--primary-deep); border-radius: 50%; font-size: 17rpx; }
.home-feature-art { position: absolute; top: 0; right: 0; width: 47%; height: 100%; object-fit: cover; }
.home-feature-fallback { display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 60rpx; }
.feature-tool-hover { box-shadow: var(--shadow-hover); transform: translateY(-2rpx); }
.home-empty { display: flex; flex-direction: column; align-items: center; margin-top: 38rpx; padding: 48rpx 24rpx; background: var(--card); border: 1rpx solid #f4e4dc; border-radius: 27rpx; text-align: center; }
.tab-safe-bottom { height: calc(env(safe-area-inset-bottom) + 118rpx); }
