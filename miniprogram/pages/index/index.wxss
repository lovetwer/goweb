/* pages/index/index.wxss —— 编辑排版风：黑 / 白 / 灰为主，红只用在强调处 */

/* ================= 顶部 ================= */
.header {
  padding: 20rpx 32rpx 26rpx;
  background: var(--paper);
}

/* 期刊号行 */
.issue-row {
  display: flex;
  align-items: center;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid var(--line);
}

.issue-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--red);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.issue-no {
  flex: 1;
  min-width: 0;
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.issue-entry {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 20rpx;
}

/* 已有收藏时书签变红（红色仅出现在这一处 + 选中态） */
.bm-icon-on {
  background: var(--red);
}

.issue-entry-text {
  font-size: 23rpx;
  color: var(--ink-2);
  margin-left: 10rpx;
  letter-spacing: 1rpx;
}

.issue-arrow {
  font-family: var(--mono);
  font-size: 24rpx;
  color: var(--ink-4);
  margin-left: 8rpx;
}

/* CSS 书签图标（未收藏态：灰描边） */
.bm-icon {
  width: 20rpx;
  height: 26rpx;
  background: var(--ink-3);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 74%, 0 100%);
  flex-shrink: 0;
}

/* 大标题：实心黑 + 描边字 */
.title-block {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  padding: 30rpx 0 6rpx;
}

.masthead {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--black);
}

/* 描边字：不支持 -webkit-text-stroke 的机型自动退化为实心黑，不会消失 */
.masthead-outline {
  margin-left: 18rpx;
  color: var(--black);
  color: transparent;
  -webkit-text-stroke: 2rpx var(--black);
}

/* 标题末尾的红色句点：整页最克制的一处红 */
.masthead-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--red);
  margin-left: 14rpx;
  transform: translateY(-6rpx);
  flex-shrink: 0;
}

/* 标题下的细分隔线 */
.rule-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.rule-label {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-4);
  flex-shrink: 0;
}

.rule-line {
  flex: 1;
  height: 2rpx;
  background: var(--line-2);
  margin: 0 18rpx;
}

.rule-count {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-4);
  flex-shrink: 0;
}

/* ================= 搜索框 ================= */
.search-bar {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-top: 28rpx;
  padding: 0 26rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  transition: border-color 0.18s ease;
}

.search-bar-focus {
  border-color: var(--black);
}

/* CSS 放大镜 */
.search-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
  margin: 0 22rpx 8rpx 2rpx;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--ink-3);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: 29rpx;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

.search-placeholder {
  color: var(--ink-4);
  font-size: 27rpx;
  letter-spacing: 0.5rpx;
}

/* CSS 关闭叉 */
.search-clear {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.clear-x,
.clear-y {
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 28rpx;
  height: 3rpx;
  background: var(--ink-3);
  border-radius: 2rpx;
}

.clear-x {
  transform: rotate(45deg);
}

.clear-y {
  transform: rotate(-45deg);
}

/* ================= 分类 Tab ================= */
.tabs {
  width: 100%;
  white-space: nowrap;
  background: var(--paper);
  padding: 4rpx 0 20rpx;
}

.tabs-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
}

.tab:last-child {
  margin-right: 32rpx;
}

.tab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 66rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  background: transparent;
  border: 2rpx solid var(--line-2);
  border-radius: 999rpx;
  transition: all 0.18s ease;
}

.tab-hover {
  border-color: var(--ink-4);
}

.tab-index {
  font-family: var(--mono);
  font-size: 19rpx;
  color: var(--ink-4);
  margin-right: 10rpx;
  letter-spacing: 1rpx;
}

.tab-text {
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}

.tab-active {
  background: var(--black);
  border-color: var(--black);
}

.tab-active.tab-hover {
  background: var(--black-3);
  border-color: var(--black-3);
}

.tab-active .tab-index {
  color: var(--red);
}

.tab-active .tab-text {
  color: #fff;
  font-weight: 600;
}

/* ================= 结果统计 ================= */
.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 36rpx 18rpx;
}

.result-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.result-bar-mark {
  width: 6rpx;
  height: 22rpx;
  background: var(--red);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.result-text {
  font-family: var(--mono);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.result-reset {
  font-size: 22rpx;
  color: var(--ink-2);
  border-bottom: 2rpx solid var(--line-2);
  padding-bottom: 2rpx;
  flex-shrink: 0;
}

/* ================= 卡片列表 ================= */
.list {
  padding: 0 24rpx;
}

.site-card {
  position: relative;
  display: flex;
  align-items: stretch;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  transition: border-color 0.18s ease;
}

.site-card-hover {
  border-color: var(--black);
}

/* 左上角编号 */
.site-no {
  position: absolute;
  left: 26rpx;
  top: 24rpx;
  width: 44rpx;
  font-family: var(--mono);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--ink-4);
  line-height: 1.4;
}

.cover-wrap {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  margin-left: 40rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--paper-2);
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-initial {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
}

.site-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.site-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.site-name {
  flex: 1;
  min-width: 0;
  font-size: 33rpx;
  font-weight: 700;
  color: var(--black);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.site-arrow {
  flex-shrink: 0;
  margin-left: 14rpx;
  font-family: var(--mono);
  font-size: 28rpx;
  color: var(--ink-4);
  transition: color 0.18s ease;
}

.site-card-hover .site-arrow {
  color: var(--red);
}

.site-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.62;
}

.site-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14rpx;
}

.site-tag {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 4rpx 14rpx 4rpx 12rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 999rpx;
  background: var(--paper);
}

.tag-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--ink-4);
  margin-right: 8rpx;
}

.tag-text {
  font-size: 20rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}

.site-url {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  text-align: right;
  font-family: var(--mono);
  font-size: 20rpx;
  color: var(--ink-4);
}

/* ================= 加载状态 ================= */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-bottom: 18rpx;
  border: 2rpx dashed var(--line-2);
  border-radius: var(--radius);
  background: transparent;
}

.load-more-text {
  font-family: var(--mono);
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: var(--ink-3);
}

.load-more-plus {
  font-family: var(--mono);
  font-size: 26rpx;
  color: var(--red);
  margin-left: 12rpx;
}

.spinner {
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--line-2);
  border-top-color: var(--red);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.load-end {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 10rpx;
}

.load-end-line {
  width: 90rpx;
  height: 2rpx;
  background: var(--line-2);
}

.load-end-text {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--ink-4);
  margin: 0 20rpx;
}

/* ================= 骨架屏 ================= */
.sk-cover {
  width: 200rpx;
  height: 150rpx;
  margin-left: 40rpx;
  border-radius: var(--radius);
  flex-shrink: 0;
}

.sk-line {
  height: 24rpx;
  margin-top: 16rpx;
  border-radius: var(--radius);
}

.sk-line-title {
  height: 34rpx;
  width: 48%;
  margin-top: 0;
}

.sk-line-short {
  width: 62%;
}
