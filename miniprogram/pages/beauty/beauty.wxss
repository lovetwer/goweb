/* pages/beauty/beauty.wxss —— 颜值分析 · 工具首页（暖纸版式） */

/* ================= 刊头 ================= */
.b-header {
  padding: 24rpx 32rpx 28rpx;
  background: var(--bg);
  border-bottom: 2rpx solid var(--line);
}

.issue-row {
  display: flex;
  align-items: center;
}

/* 刊头圆点：陶土红 + 柔光，与工具箱首页同一套锚点 */
.issue-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 6rpx var(--red-soft);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.issue-no {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--ink-4);
}

.b-title-row {
  margin-top: 22rpx;
}

.b-title {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--black);
}

.b-rule {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.b-rule-mark {
  width: 88rpx;
  height: 6rpx;
  background: var(--red);
}

.b-rule-grey {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

.b-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

/* ================= 卡片 ================= */
.b-card {
  margin: 24rpx 24rpx 0;
  padding: 26rpx 26rpx 22rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.b-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.b-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--black);
}

/* 功能说明列表 */
.b-feat {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.b-feat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink-4);
  margin: 14rpx 14rpx 0 2rpx;
  flex-shrink: 0;
}

.b-feat-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* 隐私卡片：浅陶土底，全页唯一的强调区块 */
.b-privacy {
  background: var(--red-soft);
  border: 2rpx solid var(--red-line);
  box-shadow: none;
}

.b-privacy-title {
  color: var(--red-deep);
}

.b-privacy-toggle {
  font-size: 22rpx;
  color: var(--red-deep);
  opacity: 0.8;
}

.b-privacy-main {
  margin-bottom: 4rpx;
}

.b-privacy-strong {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--red-deep);
  line-height: 1.7;
}

.b-privacy-line {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--red-deep);
  opacity: 0.85;
  line-height: 1.7;
}

.b-privacy-link-row {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--red-line);
}

.b-privacy-link {
  font-size: 22rpx;
  color: var(--red-deep);
  text-decoration: underline;
}

/* ================= 开始按钮 ================= */
.b-start-btn {
  margin: 40rpx 24rpx 0;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--red);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.b-start-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--white);
}

/* ================= 免责声明 ================= */
.b-disclaimer {
  padding: 34rpx 40rpx 10rpx;
}

.b-disclaimer-text {
  display: block;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  line-height: 1.8;
}
