.beauty-page { min-height: 100vh; background: var(--bg); overflow: hidden; }
.beauty-cover { position: relative; height: 503rpx; padding: 28rpx 42rpx 0; overflow: hidden; background: #f1e7e6; border-radius: 0 0 48rpx 48rpx; }
.beauty-cover::before { content: ''; position: absolute; top: 131rpx; right: 66rpx; width: 205rpx; height: 205rpx; border: 1rpx solid rgba(255,255,255,.78); border-radius: 50%; }
.beauty-cover::after { content: ''; position: absolute; right: 0; bottom: 0; left: 0; height: 100rpx; background: linear-gradient(180deg, rgba(241,231,230,0), #f1e7e6); }
.beauty-cover-top { position: relative; z-index: 3; display: flex; align-items: center; height: 59rpx; }
.cover-number { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; color: #fffefa; background: var(--primary); border-radius: 50%; font-family: var(--mono); font-size: 17rpx; }
.cover-series { margin-left: 12rpx; color: var(--primary-deep); font-family: var(--mono); font-size: 16rpx; letter-spacing: 1.2rpx; }
.cover-top-rule { flex: 1; height: 1rpx; margin: 0 12rpx; background: rgba(126,81,91,.18); }
.cover-wordmark { color: #a5969e; font-family: var(--mono); font-size: 13rpx; letter-spacing: 1.5rpx; }
.beauty-cover-copy { position: absolute; z-index: 2; top: 137rpx; left: 43rpx; display: flex; flex-direction: column; align-items: flex-start; }
.beauty-overline { color: var(--primary-deep); font-size: 21rpx; letter-spacing: 3rpx; }
.beauty-title { margin-top: 5rpx; color: var(--ink); font-family: var(--display); font-size: 56rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.27; }
.beauty-lead { display: flex; flex-direction: column; margin-top: 12rpx; color: #776b75; font-size: 23rpx; letter-spacing: .5rpx; line-height: 1.62; }
.beauty-cover-note { margin-top: 19rpx; padding: 7rpx 14rpx; color: var(--primary-deep); background: rgba(255,254,250,.65); border: 1rpx solid rgba(169,112,121,.19); border-radius: 999rpx; font-size: 17rpx; letter-spacing: 1rpx; }
.beauty-cover-art { position: absolute; z-index: 1; right: -20rpx; bottom: 36rpx; width: 371rpx; height: 216rpx; border-radius: 21rpx; opacity: .94; }
.beauty-cover-flower { position: absolute; z-index: 2; right: 35rpx; bottom: 210rpx; color: #c39a73; font-size: 31rpx; }
.beauty-content { position: relative; z-index: 4; margin-top: -15rpx; padding: 0 38rpx; }
.beauty-page .section-kicker { color: #a097a0; font-family: var(--mono); font-size: 15rpx; letter-spacing: 1.7rpx; }
.beauty-section-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 28rpx 3rpx 20rpx; }
.beauty-section-title { display: block; margin-top: 5rpx; color: var(--ink); font-family: var(--display); font-size: 32rpx; font-weight: 600; }
.beauty-section-index { padding-bottom: 4rpx; color: #a99fa6; font-family: var(--mono); font-size: 16rpx; letter-spacing: 1.2rpx; }
.beauty-feature-card { padding: 4rpx 25rpx; background: var(--card); border: 1rpx solid #eee7e4; border-radius: 25rpx; box-shadow: var(--shadow); }
.beauty-feature-row { display: flex; align-items: center; min-height: 111rpx; }
.beauty-feature-no { align-self: flex-start; width: 48rpx; padding-top: 29rpx; color: #b38c91; font-family: var(--mono); font-size: 17rpx; }
.beauty-feature-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.beauty-feature-title { color: var(--ink); font-family: var(--display); font-size: 24rpx; font-weight: 600; }
.beauty-feature-desc { margin-top: 2rpx; color: var(--ink-3); font-size: 20rpx; line-height: 1.5; }
.beauty-feature-mark { margin-left: 10rpx; color: #b19098; font-size: 20rpx; }
.beauty-feature-rule { height: 1rpx; margin-left: 49rpx; background: #eee8e5; }
.beauty-privacy-card { margin-top: 22rpx; padding: 24rpx 24rpx 19rpx; background: #f0ebf2; border: 1rpx solid #e4dce8; border-radius: 25rpx; }
.privacy-card-head { display: flex; align-items: center; }
.privacy-seal { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin-right: 14rpx; color: #725f71; background: #e3dce9; border-radius: 18rpx; font-size: 24rpx; }
.privacy-card-title-group { display: flex; flex: 1; flex-direction: column; }
.privacy-card-kicker { color: #99889b; font-family: var(--mono); font-size: 13rpx; letter-spacing: 1.2rpx; }
.privacy-card-title { margin-top: 2rpx; color: #413b47; font-family: var(--display); font-size: 24rpx; font-weight: 600; }
.privacy-toggle { color: #79687d; font-size: 18rpx; }
.privacy-quick-note { display: flex; flex-direction: column; margin-top: 19rpx; padding: 15rpx 17rpx; background: rgba(255,254,250,.68); border-radius: 15rpx; }
.privacy-quick-strong { color: #55494f; font-size: 21rpx; font-weight: 600; }
.privacy-quick-sub { margin-top: 3rpx; color: #928894; font-size: 17rpx; }
.privacy-expanded { display: flex; flex-direction: column; padding: 14rpx 2rpx 1rpx; }
.privacy-line { margin-top: 9rpx; color: #706976; font-size: 19rpx; line-height: 1.72; }
.privacy-card-footer { display: flex; align-items: center; justify-content: flex-end; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(150,130,151,.2); }
.privacy-link { color: #725f71; font-size: 19rpx; }
.privacy-link-arrow { margin-left: 8rpx; color: #9f8190; font-size: 20rpx; }
.beauty-cta-wrap { margin-top: 25rpx; }
.beauty-cta { padding: 22rpx 26rpx 20rpx; color: #fffefa; background: linear-gradient(115deg, #a97079, #8c626f); border-radius: 23rpx; box-shadow: 0 12rpx 23rpx rgba(126,81,91,.17); }
.beauty-cta-top { color: rgba(255,254,250,.79); font-size: 17rpx; letter-spacing: 1rpx; }
.beauty-cta-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.beauty-cta-title { font-family: var(--display); font-size: 29rpx; font-weight: 600; letter-spacing: 2rpx; }
.beauty-cta-arrow { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; color: var(--primary-deep); background: #fffefa; border-radius: 50%; font-size: 24rpx; }
.beauty-disclaimer { display: flex; align-items: flex-start; margin-top: 19rpx; padding: 0 5rpx; }
.disclaimer-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 25rpx; width: 25rpx; height: 25rpx; margin: 2rpx 10rpx 0 0; color: #a58a78; border: 1rpx solid #d7c7b9; border-radius: 50%; font-family: Georgia, serif; font-size: 16rpx; }
.beauty-disclaimer-text { color: #99909a; font-size: 17rpx; line-height: 1.65; }
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 28rpx); }
