<view class="analyze-page">
  <view class="analyze-intro">
    <view class="analyze-step"><view class="step-number">01</view><view class="step-copy"><text class="step-kicker">A PHOTO, PLEASE</text><text class="step-caption">照片仅用于本次娱乐分析</text></view></view>
    <text class="analyze-title">选一张自然的照片</text>
    <text class="analyze-subtitle">光线明亮、正脸清晰，会更容易读出温柔的细节。</text>
  </view>

  <view class="photo-card">
    <view class="photo-card-heading"><text class="photo-card-label">YOUR PORTRAIT</text><text class="photo-card-note">一张就好</text></view>
    <view class="photo-frame {{imgPath ? 'photo-frame-ready' : ''}}" bindtap="onRechoose">
      <block wx:if="{{!imgPath}}">
        <view class="ph-empty">
          <image class="ph-empty-art" src="../../assets/illustrations/tool-beauty.png" mode="aspectFill" />
          <view class="ph-empty-overlay"><view class="ph-camera-mark"><view class="camera-lens"></view></view><text class="ph-empty-text">轻触这里，选择照片</text><text class="ph-empty-sub">正脸、自然光 · 拍照或从相册选择</text></view>
        </view>
      </block>
      <block wx:else>
        <image class="ph-preview" src="{{imgPath}}" mode="aspectFit" />
        <view wx:if="{{!analyzing}}" class="ph-change" hover-class="btn-hover" catchtap="onRechoose"><text class="ph-change-text">换一张</text></view>
      </block>
      <view wx:if="{{analyzing}}" class="ph-mask"><view class="scan-scene"><view class="scan-ring scan-ring-outer"></view><view class="scan-ring scan-ring-inner"></view><view class="scan-line"></view><view class="scan-corner scan-corner-tl"></view><view class="scan-corner scan-corner-tr"></view><view class="scan-corner scan-corner-bl"></view><view class="scan-corner scan-corner-br"></view><text class="scan-sparkle scan-sparkle-one">✦</text><text class="scan-sparkle scan-sparkle-two">✧</text><text class="scan-sparkle scan-sparkle-three">✳</text></view><view class="analysis-status"><view class="spinner"></view><text class="ph-mask-kicker">A LITTLE MAGIC IN PROGRESS</text><text class="ph-mask-text">{{statusText || '正在仔细看一看…'}}</text></view></view>
    </view>
    <view wx:if="{{errorText}}" class="ph-error"><view class="ph-error-mark">!</view><view class="ph-error-copy"><text class="ph-error-label">没有完成</text><text class="ph-error-text">{{errorText}}</text></view><view class="ph-error-retry" hover-class="btn-hover" bindtap="onAnalyze">再试一次 ↗</view></view>
  </view>

  <view class="photo-advice"><view class="advice-mark">✳</view><view class="advice-copy"><text class="advice-title">一张清楚的正脸照就够了</text><text class="advice-desc">建议不要戴口罩或遮挡脸部；请仅上传本人照片。</text></view></view>

  <view class="actions">
    <block wx:if="{{!imgPath}}"><view class="act-btn act-camera" hover-class="btn-hover" bindtap="onChooseCamera"><view class="camera-icon"><view></view></view><text>现在拍一张</text></view><view class="act-btn act-album" hover-class="btn-hover" bindtap="onChooseAlbum"><text>从相册选择</text><text class="act-arrow">↗</text></view></block>
    <block wx:else><view class="act-btn act-main {{analyzing ? 'act-disabled' : ''}}" hover-class="btn-hover" bindtap="onAnalyze"><view class="act-main-copy"><text class="act-main-kicker">READY WHEN YOU ARE</text><text class="act-main-title">{{analyzing ? '正在分析…' : '开始分析'}}</text></view><view class="act-main-arrow">↗</view></view></block>
  </view>

  <view class="privacy-row"><view class="privacy-lock">✓</view><view class="privacy-copy"><text class="privacy-text">照片仅用于本次分析，云端完成后立即删除。</text><text class="privacy-sub">腾讯云处理 · Q版头像本机生成，不额外上传</text></view><text class="privacy-link" bindtap="onOpenAgreement">隐私政策 ↗</text></view>
  <view class="safe-bottom"></view>
</view>
