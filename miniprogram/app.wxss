/**
 * app.wxss —— 全局样式
 *
 * 主题配比（按视觉面积）：
 *   白 80%  —— 页面底色、卡片、导航栏、大量留白、反白文字
 *   黑  5%  —— 主标题、选中态、主按钮、发丝边按下态
 *   灰  5%  —— 正文与辅助文字、发丝分隔线、极浅填充块
 *   红  5%  —— 仅 6 处小面积强调（见 README「设计语言」）
 *   其他 5% —— 封面占位色块、骨架屏、图片本身
 *
 * 全部原生组件 + 手写 WXSS，无第三方组件库，无 emoji 图标（图标均为 CSS 绘制）
 */

page {
  /* ---- 白（主色，80%） ---- */
  --white: #ffffff;
  --bg: #ffffff;
  --card: #ffffff;

  /* ---- 黑（5%） ---- */
  --black: #0c0c0c;
  --black-2: #1a1a1a;
  --black-3: #333333;
  --ink: #111111;

  /* ---- 灰（5%） ---- */
  --ink-2: #55554f;
  --ink-3: #8b8a85;
  --ink-4: #b3b2ad;
  --line: #eceae6;
  --line-2: #dedbd5;
  --fill: #f7f6f4;
  --fill-2: #f1efec;

  /* ---- 红（5%，唯一强调色） ---- */
  --red: #e8231a;
  --red-deep: #c81b13;
  --red-soft: #fdeceb;

  --radius: 4rpx;
  --mono: 'SFMono-Regular', 'SF Mono', Menlo, Consolas, 'Courier New', monospace;

  background-color: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ---- 通用卡片：纯白 + 发丝边（白底上靠线条分层，不用阴影） ---- */
.card {
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
}

/* ---- 等宽小字 ---- */
.mono {
  font-family: var(--mono);
  letter-spacing: 1rpx;
}

/* ---- 文本截断 ---- */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ellipsis-3 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

/* ---- 空状态 / 错误 ---- */
.state-box {
  padding: 150rpx 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-icon {
  width: 108rpx;
  height: 108rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 50%;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink-4);
  margin-bottom: 34rpx;
}

.state-icon-warn {
  border-color: var(--black);
  color: var(--black);
}

.state-index {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: var(--ink-4);
  margin-bottom: 18rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.state-desc {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 14rpx;
  text-align: center;
  line-height: 1.8;
}

.state-actions {
  display: flex;
  align-items: center;
  margin-top: 46rpx;
}

.state-btn {
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 50rpx;
  background: var(--black);
  color: var(--white);
  font-size: 26rpx;
  letter-spacing: 3rpx;
  border-radius: var(--radius);
}

.state-btn.ghost {
  background: var(--white);
  color: var(--ink-2);
  border: 2rpx solid var(--line-2);
  margin-right: 20rpx;
}

/* ---- 骨架屏（计入「其他颜色」额度） ---- */
.skeleton {
  background: linear-gradient(90deg, #f1efec 25%, #f8f7f5 37%, #f1efec 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.5s ease infinite;
  border-radius: var(--radius);
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---- 进场动画 ---- */
.fade-in {
  animation: fade-in 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.btn-hover {
  opacity: 0.6;
}
