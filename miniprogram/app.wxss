/* Sweet Daybook — 马卡龙甜系原生小程序视觉系统 */
page {
  --white: #fffefd;
  --card: #fffefd;
  --bg: #fffaf5;
  --ink: #594541;
  --black: #594541;
  --ink-2: #78615b;
  --ink-3: #9a8179;
  --ink-4: #b7a19a;
  --line: #f1e2da;
  --line-2: #ead3c9;
  --fill: #fff0e8;
  --primary: #ee9d8a;
  --primary-deep: #aa5750;
  --primary-soft: #ffe9e1;
  --primary-line: #f2cfc4;
  --lavender: #f2eafa;
  --butter: #fff1d1;
  --honey: #fff1d5;
  --sky: #edf0fa;
  --shadow: 0 10rpx 30rpx rgba(151, 93, 75, .075);
  --shadow-hover: 0 16rpx 34rpx rgba(151, 93, 75, .14);
  --radius: 27rpx;
  --mono: 'SFMono-Regular', 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
  --display: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;

  background-color: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, button, image, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; color: inherit; background: transparent; border: none; border-radius: 0; font: inherit; line-height: inherit; }
button::after { border: none; }
.container { min-height: 100vh; background-color: var(--bg); }
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 26rpx); }
.card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); }
.mono { font-family: var(--mono); letter-spacing: 1rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.ellipsis-3 { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 128rpx 64rpx 110rpx; text-align: center; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; margin-bottom: 26rpx; color: var(--primary-deep); background: #ffede5; border: 1rpx solid #f5d5c9; border-radius: 38rpx 38rpx 38rpx 12rpx; font-family: var(--display); font-size: 46rpx; }
.state-icon-warn { color: #ad825b; background: var(--honey); border-color: #f0ddb6; }
.state-index { margin-bottom: 11rpx; color: var(--ink-4); font-family: var(--mono); font-size: 18rpx; letter-spacing: 4rpx; }
.state-title { color: var(--ink); font-family: var(--display); font-size: 35rpx; font-weight: 600; letter-spacing: 1rpx; }
.state-desc { margin-top: 11rpx; color: var(--ink-3); font-size: 23rpx; line-height: 1.8; }
.state-actions { display: flex; align-items: center; margin-top: 32rpx; }
.state-btn { height: 76rpx; padding: 0 37rpx; color: #fffefd; background: var(--primary-deep); border-radius: 999rpx; font-size: 25rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 76rpx; }
.state-btn.ghost { margin-right: 18rpx; color: var(--primary-deep); background: #fff0e9; border: 1rpx solid var(--primary-line); }

.skeleton { background: linear-gradient(90deg, #f3e9e2 25%, #fff8f1 37%, #f3e9e2 63%); background-size: 400% 100%; animation: skeleton-loading 1.5s ease infinite; border-radius: var(--radius); }
@keyframes skeleton-loading { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.fade-in { animation: fade-in .36s cubic-bezier(.22,.61,.36,1) both; }
@keyframes fade-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
.btn-hover { opacity: .72; }
