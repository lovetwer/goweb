/**
 * app.wxss —— 全局样式
 * 主题：黑白灰 95% + 红 5%（编辑排版 / Editorial 风格）
 * 全部原生组件 + 手写 WXSS，无第三方组件库，无 emoji 图标（图标均为 CSS 绘制）
 */

page {
  /* ---- 黑 ---- */
  --black: #0c0c0c;
  --black-2: #1a1a1a;
  --black-3: #2e2e2e;

  /* ---- 灰 ---- */
  --ink: #111111;
  --ink-2: #4a4a48;
  --ink-3: #83827e;
  --ink-4: #a9a8a3;
  --line: #e2e1dd;
  --line-2: #d3d2cd;
  --paper: #f2f1ef;
  --paper-2: #eceae6;
  --card: #ffffff;

  /* ---- 红（唯一强调色，用量 < 5%） ---- */
  --red: #e8231a;
  --red-deep: #c81b13;
  --red-soft: #fdeceb;

  --radius: 4rpx;
  --mono: 'SFMono-Regular', 'SF Mono', Menlo, Consolas, 'Courier New', monospace;

  background-color: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.container {
  min-height: 100vh;
  background-color: var(--paper);
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ---- 通用卡片：纯白 + 发丝边，几乎不用阴影（靠线条分层） ---- */
.card {
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
}

/* ---- 等宽字体小标签 ---- */
.mono {
  font-family: var(--mono);
  letter-spacing: 1rpx;
}

/* ---- 文本截断 ---- */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ellipsis-3 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

/* ---- 空状态 / 错误 ---- */
.state-box {
  padding: 140rpx 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-icon {
  width: 108rpx;
  height: 108rpx;
  border: 2rpx solid var(--line-2);
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink-4);
  margin-bottom: 34rpx;
}

.state-icon-warn {
  border-color: var(--red);
  color: var(--red);
}

.state-index {
  font-family: var(--mono);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-4);
  margin-bottom: 18rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.state-desc {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-top: 14rpx;
  text-align: center;
  line-height: 1.75;
}

.state-actions {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
}

.state-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
  background: var(--black);
  color: #fff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  border-radius: var(--radius);
}

.state-btn.ghost {
  background: transparent;
  color: var(--ink-2);
  border: 2rpx solid var(--line-2);
  margin-right: 20rpx;
}

/* ---- 骨架屏：中性灰 ---- */
.skeleton {
  background: linear-gradient(90deg, #eae9e6 25%, #f4f3f1 37%, #eae9e6 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.5s ease infinite;
  border-radius: var(--radius);
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---- 进场动画 ---- */
.fade-in {
  animation: fade-in 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.btn-hover {
  opacity: 0.7;
}
