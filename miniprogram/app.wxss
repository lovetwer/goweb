/* The Daybook — 小小日常工具箱
   以奶油纸、鸢尾紫与干燥玫瑰为主色的独立视觉系统。 */
page {
  --white: #fffefa;
  --card: #fffefa;
  --bg: #f8f5ef;
  --ink: #302e36;
  --black: #302e36;
  --ink-2: #625b65;
  --ink-3: #857d88;
  --ink-4: #a49ba5;
  --line: #ebe4e1;
  --line-2: #ddd1d3;
  --fill: #f2ebea;
  --primary: #a97079;
  --primary-deep: #7e515b;
  --primary-soft: #f4e7e8;
  --primary-line: #e8d0d4;
  --lavender: #efebf4;
  --sage: #ecebe2;
  --honey: #f5eddc;
  --sky: #eaf0f2;
  --shadow: 0 10rpx 30rpx rgba(94, 71, 78, .065);
  --shadow-hover: 0 16rpx 34rpx rgba(94, 71, 78, .12);
  --radius: 26rpx;
  --mono: 'SFMono-Regular', 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
  --display: 'Noto Serif SC', 'Songti SC', 'STSong', Georgia, serif;

  background-color: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, button, image, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; color: inherit; background: transparent; border: none; border-radius: 0; font: inherit; line-height: inherit; }
button::after { border: none; }
.container { min-height: 100vh; background-color: var(--bg); }
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 26rpx); }
.card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); }
.mono { font-family: var(--mono); letter-spacing: 1rpx; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.ellipsis-3 { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }

.state-box { display: flex; flex-direction: column; align-items: center; padding: 150rpx 64rpx 130rpx; text-align: center; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin-bottom: 30rpx; color: var(--primary); background: #f2e8e9; border: 1rpx solid #ead9dc; border-radius: 38rpx 38rpx 38rpx 10rpx; font-family: var(--display); font-size: 48rpx; }
.state-icon-warn { color: #aa8460; background: var(--honey); border-color: #eadcbf; }
.state-index { margin-bottom: 12rpx; color: var(--ink-4); font-family: var(--mono); font-size: 18rpx; letter-spacing: 4rpx; }
.state-title { color: var(--ink); font-family: var(--display); font-size: 36rpx; font-weight: 600; letter-spacing: 1rpx; }
.state-desc { margin-top: 12rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.8; }
.state-actions { display: flex; align-items: center; margin-top: 34rpx; }
.state-btn { height: 78rpx; padding: 0 38rpx; color: #fffefa; background: var(--primary); border-radius: 999rpx; font-size: 25rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 78rpx; }
.state-btn.ghost { margin-right: 18rpx; color: var(--primary-deep); background: #f7eeee; border: 1rpx solid var(--primary-line); }

.skeleton { background: linear-gradient(90deg, #efe9e7 25%, #f8f4ef 37%, #efe9e7 63%); background-size: 400% 100%; animation: skeleton-loading 1.5s ease infinite; border-radius: var(--radius); }
@keyframes skeleton-loading { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.fade-in { animation: fade-in .36s cubic-bezier(.22,.61,.36,1) both; }
@keyframes fade-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
.btn-hover { opacity: .68; }
